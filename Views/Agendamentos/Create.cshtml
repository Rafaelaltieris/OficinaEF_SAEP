@model OficinaEF.Models.Agendamento

@{
    ViewData["Title"] = "Novo agendamento";
}

<h1>Novo agendamento</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Data" class="form-label">Data e horário</label>
        <input asp-for="Data" type="datetime-local" class="form-control" />
        <span asp-validation-for="Data" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Servico" class="form-label">Serviço</label>
        <textarea asp-for="Servico" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Servico" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EquipamentoId" class="form-label">Equipamento</label>
        <select asp-for="EquipamentoId"
                asp-items="ViewBag.EquipamentoId"
                class="form-select">
            <option value="">Selecione um equipamento</option>
        </select>
        <span asp-validation-for="EquipamentoId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Cadastrar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}