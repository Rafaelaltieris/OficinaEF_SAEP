@model OficinaEF.Models.Cliente

@{
    ViewData["Title"] = "Novo Cliente";
}

<h1>Novo Cliente</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cpf" class="form-label"></label>
                <input asp-for="Cpf" class="form-control" />
                <span asp-validation-for="Cpf"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Telefone" class="form-label"></label>
                <input asp-for="Telefone" class="form-control" />
                <span asp-validation-for="Telefone"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Salvar
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Voltar
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}