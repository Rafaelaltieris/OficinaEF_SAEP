@model OficinaEF.Models.Equipamento

@{
    ViewData["Title"] = "Detalhes do equipamento";
}

<h1>Detalhes do equipamento</h1>

<dl class="row">
    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@Model.Tipo</dd>

    <dt class="col-sm-3">Modelo</dt>
    <dd class="col-sm-9">@Model.Modelo</dd>

    <dt class="col-sm-3">Cliente</dt>
    <dd class="col-sm-9">@Model.Cliente.Nome</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>